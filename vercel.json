{
    "builds": [
        {
            "src": "api/vercel.py",
            "use": "@vercel/python",
            "config": {
                "includeFiles": [
                    "index.html",
                    "vendor/**"
                ]
            }
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "/api/vercel.py"
        }
    ],
    "env": {
        "API_DASHBOARD_PATH": "index.html",
        "API_ENV": "development",
        "API_AUTH_MODE": "none",
        "API_DB_POOL_SIZE": "1",
        "API_DB_MAX_OVERFLOW": "0"
    }
}