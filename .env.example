# Copy to .env and fill in real values. .env is git-ignored; never commit it.
#   cp .env.example .env
#
# docker compose reads .env automatically. dbt and the Python scripts read
# these from the process environment, so export them in your shell first
# (see README "Configuration").

# --- Local PostgreSQL warehouse ---
# 127.0.0.1, not localhost: on Windows localhost tries IPv6 first and each
# connection then waits ~2 s for the fallback.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=connecthub
POSTGRES_PASSWORD=change-me
POSTGRES_DB=connecthub_analytics

# --- Airflow (docker-compose only) ---
# Web UI on 127.0.0.1:${AIRFLOW_PORT}; metadata in its own database.
AIRFLOW_PORT=8081
AIRFLOW_DB=airflow
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change-me
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW__WEBSERVER__SECRET_KEY=
