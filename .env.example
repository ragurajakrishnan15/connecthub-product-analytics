# Copy to .env and fill in real values. .env is git-ignored; never commit it.
#   cp .env.example .env
#
# docker compose reads .env automatically. dbt and the Python scripts read
# these from the process environment, so export them in your shell first
# (see README "Configuration").

# --- Local PostgreSQL warehouse ---
# 127.0.0.1, not localhost: on Windows localhost tries IPv6 first and each
# connection then waits ~2 s for the fallback.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=connecthub
POSTGRES_PASSWORD=change-me
POSTGRES_DB=connecthub_analytics

# --- Airflow (docker-compose only) ---
# Web UI on 127.0.0.1:${AIRFLOW_PORT}; metadata in its own database.
AIRFLOW_PORT=8081
AIRFLOW_DB=airflow
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change-me
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW__WEBSERVER__SECRET_KEY=

# --- Analytics API (python -m api; docker compose service `api`) ---
# The API logs in as its own read-only role, created by `python -m api.provision`
# (compose service `api-init`) with the POSTGRES_* owner credentials above.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(24))"
API_DB_USER=connecthub_api
API_DB_PASSWORD=change-me-api
# Published on 127.0.0.1:${API_PORT}
API_PORT=8000
# Optional (defaults shown):
#   API_ENV=development               production requires API_AUTH_MODE=api_key
#   API_AUTH_MODE=none                none | api_key (X-API-Key header)
#   API_KEYS=                         comma-separated, >= 16 characters each
#   API_CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000   never * or null
#   API_DOCS_ENABLED=                 default: on in development, off in production
#   API_STATEMENT_TIMEOUT_MS=5000
#   API_DB_POOL_SIZE=5  API_DB_MAX_OVERFLOW=5  API_WORKERS=1
#   Response cache (per worker; docs/api.md "Caching"):
#   API_CACHE_ENABLED=true  API_CACHE_TTL_S=300  API_CACHE_MAX_ENTRIES=512
#   API_CACHE_MAX_BYTES=67108864  API_DATA_VERSION_TTL_S=30  API_CACHE_MAX_AGE_S=60
#   API_DASHBOARD_PATH=index.html     serve the dashboard page at GET / (docs/api.md "Dashboard");
#                                     unset: no page. The compose service sets it for the image.
